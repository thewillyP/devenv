library identifier: 'hpc@main', retriever: modernSCM([
    $class: 'GitSCMSource', remote: 'https://github.com/thewillyP/hpc-deploy.git'])

hpcDeploy(
    image: 'devenv',

    variants: [
        cpu: [dockerUrl: 'docker://thewillyp/devenv:cpu', gpu: false],
        gpu: [dockerUrl: 'docker://thewillyp/devenv:gpu', gpu: true],
    ],

    build: [time: '00:45:00', mem: '32G', cpus: 8],
    run:   [time: '06:00:00', mem: '24G', cpus: 4],

    fakeroot: true,
    binds:    '/home/wlp9800/dev:/root/dev,/home/wlp9800/.ssh:/root/.ssh',
    tsTag:    'tag:devenv',

    // ''' not """ -- Groovy does not interpolate single-quoted strings, so
    // these $VARS reach the compute node verbatim.
    runJob: '''
        ts_up "$TS_HOSTNAME" "$TS_TAG"
        sif_run "$SIF" /entrypoint.sh
    ''',
)